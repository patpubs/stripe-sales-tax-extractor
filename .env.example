# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# At least 32 random characters (a password-manager string works), or: openssl rand -base64 32
# Encrypts Stripe keys before they are stored in Supabase. Losing it means re-entering the keys.
STRIPE_KEY_ENCRYPTION_KEY=

# Shared secret for the background worker endpoint. At least 32 random characters, or: openssl rand -hex 32
CRON_SECRET=

# The only email allowed to create the first (super admin) account on /setup.
SUPER_ADMIN_EMAIL=you@example.com

# Public URL of the app, used for invite links and for the worker to re-trigger itself.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
